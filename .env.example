# Optional: enables GET /api/live/flight/{flight_number} using Aviationstack.
# Create a local .env file (which must never be committed) and add your key.
AVIATIONSTACK_API_KEY=

# Optional operational controls
LIVE_FLIGHT_CACHE_SECONDS=300

# Only if your Aviationstack plan rejects HTTPS ("https_access_restricted"):
# AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1/flights
